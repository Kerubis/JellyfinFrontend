{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "ready in",
        "uriFormat": "http://localhost:5173",
        "action": "openExternally"
      }
    }
  ]
}
